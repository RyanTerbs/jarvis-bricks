{
  "_note": "The WORLD's rules. Code (not the AI) uses this to update needs, check moves and apply results. Try changing numbers and see what happens.",

  "needs": {
    "_note": "How much each need grows (+) or shrinks (-) per 15-minute tick. 0 = fine, 1 = urgent.",
    "rest":      { "awake": 0.020, "asleep": -0.080 },
    "hunger":    { "awake": 0.035, "asleep":  0.010 },
    "social":    { "awake": 0.025, "asleep":  0.005 },
    "tinker":    { "awake": 0.035, "asleep":  0.005 },
    "curiosity": { "awake": 0.025, "asleep":  0.005 }
  },

  "mood": {
    "_note": "Mood drifts toward 'base', pulled down by any need above 'pressing_from'. Each decoration he builds (trees, lamps...) lifts 'base' a little, up to decor_bonus_max.",
    "base": 0.35,
    "pressing_from": 0.6,
    "pressing_pull": 0.9,
    "drift": 0.25,
    "decor_bonus": 0.01,
    "decor_bonus_max": 0.10,
    "build_done_bonus": 0.20
  },

  "clock": {
    "_note": "How fast his town runs online. speed 8 = 1 of his days in about 3 real hours (like Pino). Each GitHub run lives whatever is due since the last run, at most max_ticks_per_run (so a long GitHub delay can't make him live a whole day in one go). speed 1 = real time. With the paid AI brain, cost goes up with speed.",
    "speed": 8,
    "max_ticks_per_run": 24
  },

  "bedtime": { "_note": "Local time (Florida). Between these hours autopilot sends him home to sleep, no AI calls. He writes his diary when he goes to bed.", "sleep_from_hour": 23, "wake_from_hour": 6, "wake_latest_hour": 9 },

  "town": {
    "_note": "How the town STARTS (24 lots since 2026-11-25; older towns get topped up). Lots are spots along the street (0 = far left). Everything else he builds himself.",
    "start_lots": 24,
    "start": [
      { "lot": 0, "id": "brick_pit", "name": "Brick pit", "place": "brick_pit", "desc": "a pile of loose bricks at the edge of town, with a lucky ! block floating above it", "look": { "kind": "pit" } },
      { "lot": 1, "id": "home",      "name": "Home",      "place": "home",      "desc": "his little brick house with a savings jar on the shelf", "look": { "kind": "house", "color": "#c8382e", "roof": "#7a2018", "emoji": "🏠", "floors": 1 } },
      { "lot": 2, "id": "garage",    "name": "Garage",    "place": "garage",    "desc": "the town garage, smells of oil, always a job waiting", "look": { "kind": "garage", "color": "#7d8590", "emoji": "🔧" } },
      { "lot": 3, "id": "cafe",      "name": "Cafe",      "place": "cafe",      "desc": "the corner cafe, good coffee and gossip", "look": { "kind": "shop", "color": "#2f8f5b", "emoji": "☕", "floors": 1 } }
    ]
  },

